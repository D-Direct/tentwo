  <!-- Simple JavaScript for Thumbnail Switching -->
  <script>
    function switchImage(mainImgId, clickedThumb) {
      const mainImage = document.getElementById(mainImgId);
      mainImage.src = clickedThumb.src;
      
      // Update active state among sibling thumbnails
      const siblings = clickedThumb.parentElement.children;
      for (let thumb of siblings) {
        thumb.classList.remove('active');
      }
      clickedThumb.classList.add('active');
    }
  </script>

</body>
